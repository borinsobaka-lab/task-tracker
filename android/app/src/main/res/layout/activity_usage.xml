<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Лимиты Claude»: подключение аккаунта (вход с кодом) и текущие цифры. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usage_screen_title"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/usage_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- Подключено: текущие цифры + обновить/отключить -->
        <LinearLayout
            android:id="@+id/usage_connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/usage_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="#111827"
                android:textSize="15sp" />

            <Button
                android:id="@+id/usage_reload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/refresh" />

            <Button
                android:id="@+id/usage_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/usage_logout" />
        </LinearLayout>

        <!-- Не подключено: два шага входа -->
        <LinearLayout
            android:id="@+id/usage_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/usage_login_help"
                android:textColor="#374151"
                android:textSize="14sp" />

            <Button
                android:id="@+id/usage_open_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/usage_open_login" />

            <EditText
                android:id="@+id/usage_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/usage_code_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLines="3" />

            <Button
                android:id="@+id/usage_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/usage_submit" />
        </LinearLayout>

        <TextView
            android:id="@+id/usage_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#DC2626"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
