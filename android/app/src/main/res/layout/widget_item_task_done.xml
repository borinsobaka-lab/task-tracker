<?xml version="1.0" encoding="utf-8"?>
<!-- Выполненная задача: узкая плашка. В один ряд — полоса ответственного, точка
     приоритета и зачёркнутое название. Времени нет. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg_inset"
    android:minHeight="34dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="22dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/item_bar"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/stripe" />

        <ImageView
            android:id="@+id/item_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="7dp"
            android:contentDescription="@null"
            android:visibility="gone"
            android:src="@drawable/dot" />

        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="#9AA0AE"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
