<?xml version="1.0" encoding="utf-8"?>
<!-- Строка во всю ширину. Фон-карточка (card_bg_inset) сама отступает на 8dp по
     бокам, а красная линия «сейчас» рисуется поверх во всю ширину строки. -->
<!-- Отступ между карточками задаёт ListView (dividerHeight), а НЕ margin строки:
     margin на корне элемента RemoteViews-списка некоторые лаунчеры измеряют/кладут
     неверно и срезали карточку сверху. Высота — по содержимому (wrap_content +
     minHeight), чтобы при крупном системном шрифте название не обрезалось. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg_inset"
    android:minHeight="50dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="22dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Название: одна строка сверху, обрезается с многоточием -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/item_meeting"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:visibility="gone"
                android:src="@drawable/ic_meeting" />

            <TextView
                android:id="@+id/item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#111827"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- Под названием: полоса ответственности + точка приоритета + время -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">

            <ImageView
                android:id="@+id/item_bar"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/stripe" />

            <ImageView
                android:id="@+id/item_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@null"
                android:visibility="gone"
                android:src="@drawable/dot" />

            <TextView
                android:id="@+id/item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Тег «просрочено» — в правом нижнем углу карточки (виден только у просроченных) -->
    <TextView
        android:id="@+id/item_overdue_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/overdue_tag_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="просрочено"
        android:textColor="#DC2626"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <!-- Красная линия текущего времени: во всю ширину строки (поверх карточки,
         с выходом за её боковые отступы). Видна только у идущей сейчас задачи. -->
    <FrameLayout
        android:id="@+id/item_now_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/item_now_line"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/nowline" />
    </FrameLayout>
</FrameLayout>
